#!/usr/bin/env node
// Wrapper for llxprt - just call the actual binary directly
const { spawn } = require('child_process');
const path = require('path');

const llxprtPath = '/usr/local/bin/llxprt';
const child = spawn(llxprtPath, process.argv.slice(2), {
  stdio: 'inherit',
  env: process.env
});

child.on('exit', (code) => {
  process.exit(code || 0);
});

      "cli": "llxprt",
      "name": "LLxprt ZAI GLM 4.6",
      "description": "LLxprt using ZAI GLM 4.6 via Anthropic provider interface",
      "args": [
        "--provider",
        "anthropic",
        "--baseurl",
        "https://api.z.ai/api/anthropic",
        "--key",
        { "env": "ZAI_KEY", "required": true, "sensitive": true },
        "--model",
        "glm-4.6",
        "--set",
        "context-limit=190000",
        "--set",
        "shell-replacement=true",
        "--yolo"
      ],
      "timeout": 900000

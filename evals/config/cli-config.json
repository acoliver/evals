        "--model",
        { "env": "SYNTHETIC_MINIMAX_MODEL", "default": "hf:MiniMaxAI/MiniMax-M2" },
        "--set",
        { "env": "SYNTHETIC_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "SYNTHETIC_SHELL_REPLACEMENT", "default": "shell-replacement=true" },

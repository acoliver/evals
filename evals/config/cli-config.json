{
  "configurations": {
    "llxprt-cerebras-glm46": {
      "cli": "llxprt",
      "name": "LLxprt Cerebras GLM 4.6",
      "description": "LLxprt using GLM 4.6 via ZAI proxy through Cerebras API",
      "args": [
        "--provider",
        { "env": "CEREBRAS_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "CEREBRAS_BASEURL", "default": "https://api.cerebras.ai/v1" },
        "--key",
        { "env": "CEREBRAS_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "CEREBRAS_MODEL", "default": "zai-glm-4.6" },
        "--set",
        { "env": "CEREBRAS_CONTEXT_LIMIT", "default": "context-limit=121000" },
        "--set",
        { "env": "CEREBRAS_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--set",
        "modelparam.max_tokens=8192",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-synthetic-glm46": {
      "cli": "llxprt",
      "name": "LLxprt Synthetic GLM 4.6",
      "description": "LLxprt running the Synthetic GLM-4.6 stack via explicit CLI arguments",
      "args": [
        "--provider",
        { "env": "SYNTHETIC_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "SYNTHETIC_BASEURL", "default": "https://api.synthetic.new/openai/v1" },
        "--key",
        { "env": "SYNTHETIC_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "SYNTHETIC_MODEL", "default": "hf:zai-org/GLM-4.6" },
        "--set",
        { "env": "SYNTHETIC_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "SYNTHETIC_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--set",
        "modelparam.max_tokens=10000",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-synthetic-minimax": {
      "cli": "llxprt",
      "name": "LLxprt Synthetic MiniMax M2",
      "description": "LLxprt running the Synthetic stack with MiniMax M2 model",
      "args": [
        "--provider",
        { "env": "SYNTHETIC_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "SYNTHETIC_BASEURL", "default": "https://api.synthetic.new/openai/v1" },
        "--key",
        { "env": "SYNTHETIC_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "SYNTHETIC_MINIMAX_MODEL", "default": "hf:MiniMaxAI/MiniMax-M2" },
        "--set",
        { "env": "SYNTHETIC_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "SYNTHETIC_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--set",
        "modelparam.max_tokens=10000",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-zai-glm46": {
      "cli": "llxprt",
      "name": "LLxprt ZAI GLM 4.6",
      "description": "LLxprt using ZAI GLM 4.6 via ZAI API (Anthropic format)",
      "args": [
        "--provider",
        "anthropic",
        "--baseurl",
        "https://api.z.ai/api/anthropic",
        "--key",
        { "env": "ZAI_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "ZAI_MODEL", "default": "glm-4.6" },
        "--set",
        { "env": "ZAI_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "ZAI_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--set",
        "modelparam.max_tokens=10000",
        "--yolo"
      ],
      "timeout": 900000
    },
    "codepuppy-cerebras-glm46": {
      "cli": "codepuppy-wrapper.sh",
      "name": "Code Puppy Cerebras GLM 4.6",
      "description": "Code Puppy agent using ZAI GLM 4.6 through Cerebras API",
      "promptPrefix": "/set model zai-glm-4.6",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    },
    "codepuppy-synthetic-glm46": {
      "cli": "codepuppy-wrapper.sh",
      "name": "Code Puppy Synthetic GLM 4.6",
      "description": "Code Puppy agent targeting Synthetic GLM 4.6",
      "promptPrefix": "/set model synthetic-GLM-4.6",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    },
    "codepuppy-synthetic-minimax": {
      "cli": "codepuppy-wrapper.sh",
      "name": "Code Puppy Synthetic MiniMax M2",
      "description": "Code Puppy agent targeting Synthetic MiniMax M2",
      "promptPrefix": "/set model synthetic-MiniMax-M2",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    },
    "codepuppy-zai-glm46": {
      "cli": "codepuppy-wrapper.sh",
      "name": "Code Puppy ZAI GLM 4.6",
      "description": "Code Puppy agent targeting ZAI GLM 4.6",
      "promptPrefix": "/set model glm-4.6-api",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    }
  },
  "defaultConfigurations": [
    "llxprt-cerebras-glm46",
    "llxprt-synthetic-glm46",
    "llxprt-synthetic-minimax",
    "llxprt-zai-glm46",
    "codepuppy-cerebras-glm46",
    "codepuppy-synthetic-glm46",
    "codepuppy-synthetic-minimax",
    "codepuppy-zai-glm46"
  ]
}

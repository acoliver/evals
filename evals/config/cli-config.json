{
  "configurations": {
    "llxprt-synthetic-main": {
      "cli": "llxprt",
      "name": "LLxprt Synthetic GLM 4.6",
      "description": "LLxprt running the Synthetic GLM-4.6 stack via explicit CLI arguments",
      "args": [
        "--provider",
        { "env": "SYNTHETIC_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "SYNTHETIC_BASEURL", "default": "https://api.synthetic.new/openai/v1" },
        "--key",
        { "env": "SYNTHETIC_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "SYNTHETIC_MODEL", "default": "hf:zai-org/GLM-4.6" },
        "--set",
        { "env": "SYNTHETIC_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "SYNTHETIC_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-synthetic-minimax": {
      "cli": "llxprt",
      "name": "LLxprt Synthetic MiniMax M2",
      "description": "LLxprt running the Synthetic stack with MiniMax M2 model",
      "args": [
        "--provider",
        { "env": "SYNTHETIC_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "SYNTHETIC_BASEURL", "default": "https://api.synthetic.new/openai/v1" },
        "--key",
        { "env": "SYNTHETIC_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "SYNTHETIC_MINIMAX_MODEL", "default": "hf:MiniMaxAI/MiniMax-M2" },
        "--set",
        { "env": "SYNTHETIC_CONTEXT_LIMIT", "default": "context-limit=190000" },
        "--set",
        { "env": "SYNTHETIC_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-cerebras-main": {
      "cli": "llxprt",
      "name": "LLxprt Cerebras Qwen 3",
      "description": "LLxprt running Cerebras-hosted Qwen 3 Coder with env-driven arguments",
      "args": [
        "--provider",
        { "env": "CEREBRAS_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "CEREBRAS_BASEURL", "default": "https://api.cerebras.ai/v1" },
        "--key",
        { "env": "CEREBRAS_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "CEREBRAS_MODEL", "default": "qwen-3-coder-480b" },
        "--set",
        { "env": "CEREBRAS_CONTEXT_LIMIT", "default": "context-limit=128000" },
        "--set",
        { "env": "CEREBRAS_CUSTOM_HEADERS", "default": "custom-headers=response_format.json_schema.strict true" },
        "--set",
        { "env": "CEREBRAS_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--yolo"
      ],
      "timeout": 900000
    },
    "llxprt-cerebras-glm46": {
      "cli": "llxprt",
      "name": "LLxprt Cerebras GLM 4.6",
      "description": "LLxprt using Cerebras endpoint with the GLM 4.6 model and tighter max token cap",
      "args": [
        "--provider",
        { "env": "CEREBRAS_PROVIDER", "default": "openai" },
        "--baseurl",
        { "env": "CEREBRAS_BASEURL", "default": "https://api.cerebras.ai/v1" },
        "--key",
        { "env": "CEREBRAS_KEY", "required": true, "sensitive": true },
        "--model",
        { "env": "CEREBRAS_GLM46_MODEL", "default": "zai-glm-4.6" },
        "--set",
        { "env": "CEREBRAS_CONTEXT_LIMIT", "default": "context-limit=128000" },
        "--set",
        { "env": "CEREBRAS_CUSTOM_HEADERS", "default": "custom-headers=response_format.json_schema.strict true" },
        "--set",
        { "env": "CEREBRAS_SHELL_REPLACEMENT", "default": "shell-replacement=true" },
        "--set",
        "modelparam.temperature=1",
        "--set",
        { "env": "CEREBRAS_GLM46_MAX_TOKENS", "default": "modelparam.max_tokens=10000" },
        "--yolo"
      ],
      "timeout": 900000
    },
    "codepuppy-synthetic-glm46": {
      "cli": "code-puppy",
      "name": "Code Puppy Synthetic GLM 4.6",
      "description": "Code Puppy agent targeting Synthetic GLM 4.6 via Synthetic provider",
      "promptPrefix": "/set model synthetic-GLM-4.6",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    },
    "codepuppy-cerebras-glm46": {
      "cli": "code-puppy",
      "name": "Code Puppy Cerebras GLM 4.6",
      "description": "Code Puppy agent targeting Cerebras-hosted GLM 4.6",
      "promptPrefix": "/set model Cerebras-GLM-4.6",
      "args": [
        "--prompt",
        { "prompt": true }
      ],
      "timeout": 900000
    }
  },
  "defaultConfigurations": [
    "llxprt-synthetic-main",
    "llxprt-synthetic-minimax",
    "llxprt-cerebras-main",
    "llxprt-cerebras-glm46",
    "codepuppy-synthetic-glm46",
    "codepuppy-cerebras-glm46"
  ]
}
